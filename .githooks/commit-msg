#!/usr/bin/env bash
# Hook commit-msg. Ative uma vez por clone: git config core.hooksPath .githooks
# Valida a configuração antes de alterar a mensagem. O checador também aplica as regras no CI.
set -u

msg_file="${1:?uso: commit-msg <arquivo-da-mensagem>}"
root="$(cd "$(dirname "$0")/.." && pwd)"
cfg="${ADS_DEVFLOW_TOML:-$root/defaults/devflow.toml}"
checker="$root/.github/scripts/check-commits.sh"
# shellcheck source=../.github/scripts/lib-devflow.sh
. "$root/.github/scripts/lib-devflow.sh"

if [ ! -r "$cfg" ]; then
  echo "commit-msg: arquivo de parâmetros não encontrado: $cfg" >&2
  exit 1
fi
# O erro de configuração vence o desligamento, como no checador e no CI.
bash "$checker" --check-config || exit $?
[ "$(cfg_str commits.enabled true)" = "false" ] && exit 0

ident="$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed -E 's/ [0-9]+ [+-][0-9]{4}$//')"
author_email="$(printf '%s' "$ident" | sed -nE 's/.*<([^<>]*)>$/\1/p')"
if [ -z "$author_email" ]; then
  echo "commit-msg: identidade do autor não configurada (user.name e user.email)." >&2
  exit 1
fi

# 1. Coautor
ai="$(cfg_str ai_attribution executor)"
who="$(printf '%s' "${ADS_AI_AUTHOR:-}" | tr '[:upper:]' '[:lower:]')"
if [ "$ai" = "agent-author" ] && [ -n "$who" ]; then
  case "$who" in
    claude|codex) ;;
    *) echo "commit-msg: ADS_AI_AUTHOR inválida (use claude ou codex)." >&2; exit 1 ;;
  esac
  agent="$(cfg_str "agent.$who")"
  committer="$(git var GIT_COMMITTER_IDENT 2>/dev/null | sed -E 's/ [0-9]+ [+-][0-9]{4}$//')"
  if [ "$ident" != "$agent" ] || [ "$committer" != "$agent" ]; then
    echo "commit-msg: autor e committer devem ser agent.$who. Use bash tools/commit-as-agent.sh $who '<assunto>'." >&2
    exit 1
  fi
  co="$(cfg_str coauthor.owner)"
elif [ "$ai" = "executor" ] && [ -n "$who" ]; then
  if ! [[ "$who" =~ ^[a-z0-9_-]+$ ]]; then
    echo "commit-msg: ADS_AI_AUTHOR inválida (use claude, codex ou deixe vazia)." >&2
    exit 1
  fi
  co="$(cfg_str "coauthor.$who")"
  if [ -z "$co" ]; then
    echo "commit-msg: ADS_AI_AUTHOR=\"$who\" não tem entrada coauthor.$who em devflow.toml." >&2
    exit 1
  fi
fi
if [ -n "${co:-}" ]; then
  git interpret-trailers --in-place --if-exists doNothing --trailer "Co-authored-by: $co" "$msg_file" || exit $?
fi

# 2. Sign-off
if [ "$(cfg_str commits.signoff_required true)" = "true" ] && [ "$(cfg_str commits.signoff_autoadd true)" = "true" ]; then
  git interpret-trailers --in-place --if-exists doNothing --trailer "Signed-off-by: $ident" "$msg_file"
fi

# 3. Validação
branch="$(git symbolic-ref --short -q HEAD 2>/dev/null || true)"
merge_args=()
if [ -n "$branch" ] &&
   merge_head="$(git rev-parse --verify --quiet MERGE_HEAD)" &&
   [ "$merge_head" = "$(git rev-parse --verify --quiet refs/heads/develop)" ]; then
  merge_args=(--merge-subject "Merge branch 'develop' into $branch")
fi
exec bash "$checker" --message "$msg_file" --author "$author_email" --strip-comments --branch "$branch" "${merge_args[@]}"
