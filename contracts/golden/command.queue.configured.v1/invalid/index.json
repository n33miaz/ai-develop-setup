{
  "01-missing-meta.json": {
    "rule": "O _meta do envelope é obrigatório.",
    "keyword": "required",
    "instancePath": "/params",
    "params": {
      "missingProperty": "_meta"
    }
  },
  "02-extra-param.json": {
    "rule": "params é fechado: o pedido não leva nada além do _meta, nem o id da fila.",
    "keyword": "additionalProperties",
    "instancePath": "/params",
    "params": {
      "additionalProperty": "queue_id"
    }
  },
  "03-other-method.json": {
    "rule": "O método é fixo.",
    "keyword": "const",
    "instancePath": "/method"
  }
}
