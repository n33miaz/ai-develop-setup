{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:contract:pty-host.response:1",
  "title": "Resposta do host de PTY",
  "description": "Resposta JSON-RPC 2.0 do host de PTY: ou result ou error, nunca os dois. O result tem uma das formas do contrato (vazio, saudação, limites do replay, encerramento ou lista de sessões). Erro de replay informa o limite: nada é pulado em silêncio.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jsonrpc",
    "id"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/empty"
        },
        {
          "$ref": "#/$defs/hello"
        },
        {
          "$ref": "#/$defs/replay_bounds"
        },
        {
          "$ref": "#/$defs/closed"
        },
        {
          "$ref": "#/$defs/session_list"
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            -32700,
            -32600,
            -32601,
            -32602,
            -32603,
            -32001,
            -32002,
            -32003,
            -32004,
            -32005,
            -32006,
            -32007,
            -32008,
            -32009
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "oldest_seq": {
              "type": "integer",
              "minimum": 1
            },
            "next_seq": {
              "type": "integer",
              "minimum": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": -32004
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "oldest_seq"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": -32005
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "next_seq"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "required": [
        "result"
      ]
    },
    {
      "required": [
        "error"
      ]
    }
  ],
  "$defs": {
    "empty": {
      "type": "object",
      "additionalProperties": false
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract"
      ],
      "properties": {
        "contract": {
          "const": "pty-host/1"
        }
      }
    },
    "replay_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oldest_seq",
        "next_seq"
      ],
      "properties": {
        "oldest_seq": {
          "type": "integer",
          "minimum": 1
        },
        "next_seq": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "closed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code"
      ],
      "properties": {
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "session_list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessions"
      ],
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "session_id",
              "running",
              "exit_code",
              "oldest_seq",
              "next_seq"
            ],
            "properties": {
              "session_id": {
                "$ref": "urn:ads:common:id:1"
              },
              "running": {
                "type": "boolean"
              },
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "oldest_seq": {
                "type": "integer",
                "minimum": 1
              },
              "next_seq": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "jsonrpc": "2.0",
      "id": 2,
      "result": {}
    }
  ]
}
