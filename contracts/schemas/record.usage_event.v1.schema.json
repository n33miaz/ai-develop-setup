{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:record:usage_event:1",
  "title": "Evento de uso",
  "description": "Uma linha do livro-caixa: uma chamada ou turno de IA medido, com tokens, duração, custo de lista, custo faturável (só chave de API), janela de cota, fonte e chave de deduplicação. Só-anexo; alias de conta nunca é credencial nem e-mail.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "event_id",
    "ts",
    "task_id",
    "parent_task_id",
    "session_id",
    "workspace",
    "project_id",
    "os_user",
    "role",
    "harness",
    "provider",
    "account_alias",
    "model_requested",
    "model_effective",
    "effort_requested",
    "effort_effective",
    "routing_mode",
    "routing_rule_id",
    "tokens_in",
    "tokens_out",
    "tokens_cache_read",
    "tokens_cache_write",
    "duration_ms",
    "status",
    "error_code",
    "price_version",
    "cost_list_usd",
    "cost_billable_usd",
    "quota_window_before",
    "quota_window_after",
    "source",
    "source_ref",
    "dedupe_key"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "event_id": {
      "$ref": "urn:ads:common:id:1"
    },
    "ts": {
      "$ref": "urn:ads:common:timestamp:1"
    },
    "task_id": {
      "anyOf": [
        {
          "$ref": "urn:ads:common:id:1"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_task_id": {
      "anyOf": [
        {
          "$ref": "urn:ads:common:id:1"
        },
        {
          "type": "null"
        }
      ]
    },
    "session_id": {
      "anyOf": [
        {
          "$ref": "urn:ads:common:id:1"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspace": {
      "$ref": "urn:ads:common:id:1"
    },
    "project_id": {
      "anyOf": [
        {
          "$ref": "urn:ads:common:id:1"
        },
        {
          "type": "null"
        }
      ]
    },
    "os_user": {
      "$ref": "urn:ads:common:id:1"
    },
    "role": {
      "enum": [
        "executor",
        "reviewer",
        "router",
        "advisor",
        "orchestrator"
      ]
    },
    "harness": {
      "$ref": "urn:ads:common:id:1"
    },
    "provider": {
      "$ref": "urn:ads:common:id:1"
    },
    "account_alias": {
      "$ref": "urn:ads:common:id:1"
    },
    "model_requested": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "model_effective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "effort_requested": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        {
          "type": "null"
        }
      ]
    },
    "effort_effective": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        {
          "type": "null"
        }
      ]
    },
    "routing_mode": {
      "anyOf": [
        {
          "enum": [
            "manual",
            "propose",
            "auto",
            "shadow"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "routing_rule_id": {
      "anyOf": [
        {
          "$ref": "urn:ads:common:id:1"
        },
        {
          "type": "null"
        }
      ]
    },
    "tokens_in": {
      "type": "integer",
      "minimum": 0
    },
    "tokens_out": {
      "type": "integer",
      "minimum": 0
    },
    "tokens_cache_read": {
      "type": "integer",
      "minimum": 0
    },
    "tokens_cache_write": {
      "type": "integer",
      "minimum": 0
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "ok",
        "error",
        "429",
        "aborted",
        "fallback"
      ]
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^E_[A-Z0-9_]{1,60}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "price_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "cost_list_usd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "cost_billable_usd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "quota_window_before": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "five_hour_pct",
            "weekly_pct"
          ],
          "properties": {
            "five_hour_pct": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "weekly_pct": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "quota_window_after": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "five_hour_pct",
            "weekly_pct"
          ],
          "properties": {
            "five_hour_pct": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "weekly_pct": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "enum": [
        "adapter",
        "cli_json",
        "statusline",
        "transcript",
        "rollout",
        "usagebar",
        "manual"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "dedupe_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "if": {
    "properties": {
      "status": {
        "enum": [
          "error",
          "429"
        ]
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "properties": {
      "error_code": {
        "type": "string"
      }
    }
  },
  "examples": [
    {
      "version": 1,
      "event_id": "usage-01",
      "ts": "2030-01-02T03:04:05Z",
      "task_id": "task-01",
      "parent_task_id": null,
      "session_id": "sess-01",
      "workspace": "ws-01",
      "project_id": "proj-01",
      "os_user": "user-01",
      "role": "executor",
      "harness": "harness-a",
      "provider": "provider-a",
      "account_alias": "acct-01",
      "model_requested": "model-x",
      "model_effective": "model-x",
      "effort_requested": "medium",
      "effort_effective": "medium",
      "routing_mode": "manual",
      "routing_rule_id": null,
      "tokens_in": 1200,
      "tokens_out": 340,
      "tokens_cache_read": 800,
      "tokens_cache_write": 0,
      "duration_ms": 5200,
      "status": "ok",
      "error_code": null,
      "price_version": "tiers-2030-01-01",
      "cost_list_usd": 0.0123,
      "cost_billable_usd": null,
      "quota_window_before": {
        "five_hour_pct": 10,
        "weekly_pct": 3.5
      },
      "quota_window_after": {
        "five_hour_pct": 11,
        "weekly_pct": 3.6
      },
      "source": "adapter",
      "source_ref": "turn:42",
      "dedupe_key": "harness-a:sess-01:42"
    }
  ]
}
