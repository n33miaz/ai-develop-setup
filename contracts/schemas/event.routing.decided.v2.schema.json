{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:event:routing.decided:2",
  "title": "Rota decidida",
  "description": "A rota em vigor de uma tarefa foi fixada: pelo dono (modo manual, ou aceite de uma proposta) ou por regra (modo auto). O autor do evento diz quem decidiu. Inclui o apelido da conta, quando aplicável.",
  "allOf": [
    {
      "$ref": "urn:ads:event:envelope:1"
    },
    {
      "type": "object",
      "required": [
        "type",
        "stream",
        "data"
      ],
      "properties": {
        "type": {
          "const": "urn:ads:event:routing.decided:2"
        },
        "stream": {
          "type": "string",
          "pattern": "^routing/"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task_id",
            "mode",
            "rule_id",
            "tier",
            "harness",
            "provider",
            "model",
            "effort",
            "account_alias"
          ],
          "properties": {
            "task_id": {
              "$ref": "urn:ads:common:id:1"
            },
            "mode": {
              "enum": [
                "manual",
                "propose",
                "auto",
                "shadow"
              ]
            },
            "rule_id": {
              "anyOf": [
                {
                  "$ref": "urn:ads:common:id:1"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tier": {
              "type": "string",
              "pattern": "^T[0-3]$"
            },
            "harness": {
              "$ref": "urn:ads:common:id:1"
            },
            "provider": {
              "$ref": "urn:ads:common:id:1"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "effort": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                {
                  "type": "null"
                }
              ]
            },
            "account_alias": {
              "anyOf": [
                {
                  "$ref": "urn:ads:common:id:1"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "id": "01ARZ3NDEKTSV4RRFFQ69G5FAB",
      "type": "urn:ads:event:routing.decided:2",
      "ts": "2030-01-02T03:04:05Z",
      "stream": "routing/task-01",
      "seq": 1,
      "actor": {
        "kind": "daemon",
        "id": "core-01"
      },
      "cause": null,
      "data_class": "internal",
      "data": {
        "task_id": "task-01",
        "mode": "auto",
        "rule_id": "rule-01",
        "tier": "T1",
        "harness": "harness-a",
        "provider": "provider-a",
        "model": "model-x",
        "effort": "medium",
        "account_alias": "primary"
      }
    }
  ]
}
