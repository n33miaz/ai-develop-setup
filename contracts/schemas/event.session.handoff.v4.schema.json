{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:event:session.handoff:4",
  "title": "Decisão de passagem entre sessões",
  "description": "Registra a proposta ou a decisão sobre uma passagem, com o gatilho. Aceite e recusa exigem um aparelho como autor e o canal do consentimento. O aceite de uma oferta após recusa de modelo nomeia a alternativa escolhida.",
  "allOf": [
    {
      "$ref": "urn:ads:event:envelope:1"
    },
    {
      "type": "object",
      "required": [
        "type",
        "stream",
        "data"
      ],
      "properties": {
        "type": {
          "const": "urn:ads:event:session.handoff:4"
        },
        "stream": {
          "type": "string",
          "pattern": "^handoff/"
        },
        "data_class": {
          "const": "private"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handoff_id",
            "source_session_id",
            "trigger",
            "status"
          ],
          "properties": {
            "handoff_id": {
              "$ref": "urn:ads:common:id:1"
            },
            "source_session_id": {
              "$ref": "urn:ads:common:id:1"
            },
            "trigger": {
              "enum": [
                "context_limit",
                "account_switch",
                "model_refusal"
              ],
              "description": "Gatilho da passagem, com os mesmos valores do registro."
            },
            "status": {
              "enum": [
                "proposed",
                "accepted",
                "declined"
              ]
            },
            "channel": {
              "enum": [
                "local",
                "remote"
              ],
              "description": "Canal pelo qual o aparelho aceitou ou recusou. Ausente na proposta."
            },
            "alternative_id": {
              "$ref": "urn:ads:common:id:1",
              "description": "Identificador, no catálogo de rotas, da alternativa que o aparelho aceitou. Obrigatório no aceite com gatilho model_refusal."
            }
          }
        }
      },
      "if": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "accepted",
                  "declined"
                ]
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "actor": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "device"
              }
            }
          },
          "data": {
            "type": "object",
            "required": [
              "channel"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "object",
            "not": {
              "required": [
                "channel"
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "if": {
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "trigger",
              "status"
            ],
            "properties": {
              "trigger": {
                "const": "model_refusal"
              },
              "status": {
                "const": "accepted"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "alternative_id"
            ]
          }
        }
      }
    }
  ],
  "examples": [
    {
      "id": "01ARZ3NDEKTSV4RRFFQ69G5FAB",
      "type": "urn:ads:event:session.handoff:4",
      "ts": "2030-01-02T03:04:05Z",
      "stream": "handoff/handoff-1",
      "seq": 1,
      "actor": {
        "kind": "daemon",
        "id": "core-01"
      },
      "cause": null,
      "data_class": "private",
      "data": {
        "handoff_id": "handoff-1",
        "source_session_id": "session-1",
        "trigger": "context_limit",
        "status": "proposed"
      }
    }
  ]
}
