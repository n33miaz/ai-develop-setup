{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:record:action-plan:1",
  "title": "Plano de ação",
  "description": "O plano de uma ação destrutiva sobre arquivos, como o portão o julgou: a operação pedida, os alvos, a raiz de trabalho, a estimativa do ensaio, o veredito com as regras que dispararam, se o apagar virou mover para a quarentena e o destino. O plan_hash cobre o plano em vigor (o reescrito, quando há quarentena) e pode ser reconferido a partir deste registro pela serialização canônica descrita no README.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "action_id",
    "plan_hash",
    "operation",
    "work_root",
    "destination",
    "targets",
    "estimate",
    "verdict",
    "quarantined"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "action_id": {
      "$ref": "urn:ads:common:id:1"
    },
    "plan_hash": {
      "$ref": "urn:ads:common:sha256:1"
    },
    "operation": {
      "enum": [
        "fs.delete",
        "fs.delete_recursive",
        "fs.move",
        "fs.overwrite",
        "fs.clean_untracked"
      ]
    },
    "work_root": {
      "$ref": "urn:ads:common:abspath:1"
    },
    "destination": {
      "anyOf": [
        {
          "$ref": "urn:ads:common:abspath:1"
        },
        {
          "type": "null"
        }
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "pattern",
          "repo_root"
        ],
        "properties": {
          "path": {
            "$ref": "urn:ads:common:abspath:1"
          },
          "pattern": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255,
                "pattern": "^[^\\\\/$%]*[*?][^\\\\/$%]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "repo_root": {
            "type": "boolean"
          }
        }
      }
    },
    "estimate": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items",
            "bytes"
          ],
          "properties": {
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "risk",
        "reasons"
      ],
      "properties": {
        "decision": {
          "enum": [
            "allowed",
            "requires_approval",
            "denied"
          ]
        },
        "risk": {
          "$ref": "urn:ads:common:risk:1"
        },
        "reasons": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "subject"
            ],
            "properties": {
              "rule": {
                "$ref": "urn:ads:common:action-rule:1"
              },
              "subject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "allowed"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "risk": {
                "const": "low"
              },
              "reasons": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "const": "requires_approval"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "risk": {
                "const": "medium"
              },
              "reasons": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "const": "denied"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "risk": {
                "const": "high"
              },
              "reasons": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "quarantined": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "quarantined": {
            "const": true
          }
        },
        "required": [
          "quarantined"
        ]
      },
      "then": {
        "properties": {
          "operation": {
            "enum": [
              "fs.delete",
              "fs.delete_recursive"
            ]
          },
          "destination": {
            "type": "string"
          },
          "verdict": {
            "type": "object",
            "properties": {
              "decision": {
                "enum": [
                  "allowed",
                  "requires_approval"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "fs.move"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "destination": {
            "type": "string"
          },
          "quarantined": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "fs.delete",
              "fs.delete_recursive",
              "fs.overwrite",
              "fs.clean_untracked"
            ]
          },
          "quarantined": {
            "const": false
          }
        },
        "required": [
          "operation",
          "quarantined"
        ]
      },
      "then": {
        "properties": {
          "destination": {
            "type": "null"
          }
        }
      }
    }
  ],
  "examples": [
    {
      "version": 1,
      "action_id": "act-01",
      "plan_hash": "sha256:c7b870d89ef435eb431fcdf8e99f82f2b10c9b05a25eb86eb2ed603fa366eb94",
      "operation": "fs.delete_recursive",
      "work_root": "/work/proj",
      "destination": null,
      "targets": [
        {
          "path": "/work/proj/a",
          "pattern": null,
          "repo_root": false
        },
        {
          "path": "/work/proj/b",
          "pattern": null,
          "repo_root": false
        }
      ],
      "estimate": {
        "items": 3,
        "bytes": 4096
      },
      "verdict": {
        "decision": "allowed",
        "risk": "low",
        "reasons": []
      },
      "quarantined": false
    }
  ]
}
