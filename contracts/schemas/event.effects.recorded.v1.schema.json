{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:event:effects.recorded:1",
  "title": "Efeitos concretos registrados",
  "description": "O registro record.action-effects:1 que o ensaio de uma ação achou, gravado pelo núcleo logo depois do plano, no stream effects/<action_id>, uma vez só (seq 1). effects_hash é o SHA-256 da serialização do registro que o núcleo grava; a resposta do dono (answer.recorded:2) repete esse hash, e a execução só começa se o ensaio dela achar o mesmo registro.",
  "allOf": [
    {
      "$ref": "urn:ads:event:envelope:1"
    },
    {
      "type": "object",
      "required": [
        "type",
        "stream",
        "seq",
        "data",
        "actor"
      ],
      "properties": {
        "type": {
          "const": "urn:ads:event:effects.recorded:1"
        },
        "stream": {
          "type": "string",
          "pattern": "^effects/"
        },
        "seq": {
          "const": 1
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_id",
            "plan_hash",
            "effects_hash",
            "effects"
          ],
          "properties": {
            "action_id": {
              "$ref": "urn:ads:common:id:1"
            },
            "plan_hash": {
              "$ref": "urn:ads:common:sha256:1"
            },
            "effects_hash": {
              "$ref": "urn:ads:common:sha256:1"
            },
            "effects": {
              "$ref": "urn:ads:record:action-effects:1"
            }
          }
        },
        "actor": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "kind": {
              "const": "daemon"
            }
          }
        }
      }
    }
  ],
  "examples": [
