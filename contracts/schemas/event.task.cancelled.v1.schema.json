{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:event:task.cancelled:1",
  "title": "Tarefa cancelada",
  "description": "A tarefa foi interrompida por decisão do dono, por teto de custo, por pressão de recursos, por política ou por ter sido substituída.",
  "allOf": [
    {
      "$ref": "urn:ads:event:envelope:1"
    },
    {
      "type": "object",
      "required": [
        "type",
        "stream",
        "data"
      ],
      "properties": {
        "type": {
          "const": "urn:ads:event:task.cancelled:1"
        },
        "stream": {
          "type": "string",
          "pattern": "^task/"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task_id",
            "reason"
          ],
          "properties": {
            "task_id": {
              "$ref": "urn:ads:common:id:1"
            },
            "reason": {
              "enum": [
                "owner",
                "budget",
                "host_pressure",
                "policy",
                "superseded"
              ]
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "id": "01ARZ3NDEKTSV4RRFFQ69G5FAB",
      "type": "urn:ads:event:task.cancelled:1",
      "ts": "2030-01-02T03:04:05Z",
      "stream": "task/task-01",
      "seq": 1,
      "actor": {
        "kind": "daemon",
        "id": "core-01"
      },
      "cause": null,
      "data_class": "internal",
      "data": {
        "task_id": "task-01",
        "reason": "owner"
      }
    }
  ]
}
