{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:event:answer.recorded:2",
  "title": "Resposta do dono registrada",
  "description": "A resposta do dono a uma aprovação, gravada antes de o portão agir sobre ela: o aparelho (actor), o dono, o instante (ts), a decisão, o plano que o dono viu, o hash do registro de efeitos concretos que a listagem mostrou (effects_hash, null quando a ação não tem esse registro) e a chave de idempotência do comando, que deduplica a resposta no log. Fica no stream answer/<approval_id>. A decisão do portão vem depois, em approval.granted:2 ou approval.denied:2, e pode ser uma negação mesmo quando o dono aprovou (política mudou). A versão 2 acrescenta effects_hash, obrigatório.",
  "allOf": [
    {
      "$ref": "urn:ads:event:envelope:1"
    },
    {
      "type": "object",
      "required": [
        "type",
        "stream",
        "data",
        "actor"
      ],
      "properties": {
        "type": {
          "const": "urn:ads:event:answer.recorded:2"
        },
        "stream": {
          "type": "string",
          "pattern": "^answer/"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approval_id",
            "action_id",
            "plan_hash",
            "effects_hash",
            "decision",
            "owner_id",
            "via",
            "idempotency_key"
          ],
          "properties": {
            "approval_id": {
              "$ref": "urn:ads:common:id:1"
            },
            "action_id": {
              "$ref": "urn:ads:common:id:1"
            },
            "plan_hash": {
              "$ref": "urn:ads:common:sha256:1"
            },
            "effects_hash": {
              "anyOf": [
                {
                  "$ref": "urn:ads:common:sha256:1"
                },
                {
                  "type": "null"
                }
              ]
            },
            "decision": {
              "enum": [
                "approve",
                "deny"
              ]
            },
            "owner_id": {
              "$ref": "urn:ads:common:id:1"
            },
            "via": {
              "enum": [
                "local_ui",
                "tray",
                "remote_device"
              ]
            },
            "idempotency_key": {
              "$ref": "urn:ads:common:ulid:1"
            }
          }
        },
        "actor": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "kind": {
              "const": "device"
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "id": "01ARZ3NDEKTSV4RRFFQ69G5FAB",
      "type": "urn:ads:event:answer.recorded:2",
      "ts": "2030-01-02T03:05:00Z",
      "stream": "answer/appr-03",
      "seq": 1,
      "actor": {
        "kind": "device",
        "id": "device-01"
      },
      "cause": "01ARZ3NDEKTSV4RRFFQ69G5FAD",
      "data_class": "internal",
      "data": {
        "approval_id": "appr-03",
        "action_id": "act-03",
        "plan_hash": "sha256:5486cc58827bffeb2204a994db3d77fe6c8f2c863eb73de6e2a60802784293cb",
        "effects_hash": "sha256:9f2b1c4e8a7d6c5b4a39281706f5e4d3c2b1a09f8e7d6c5b4a3928170605f4e3",
        "decision": "approve",
        "owner_id": "owner-01",
        "via": "local_ui",
        "idempotency_key": "01ARZ3NDEKTSV4RRFFQ69G5FAE"
      }
    }
  ]
}
