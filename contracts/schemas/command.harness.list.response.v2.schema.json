{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:command:harness.list.response:2",
  "title": "Resposta de harness.list",
  "description": "Resposta JSON-RPC 2.0 aceita de harness.list. Lista as ferramentas ligadas e os apelidos de pasta. A versão 2 acrescenta os apelidos das pastas indisponíveis na partida, omitidos quando não há nenhuma. Só nomes; nunca inclui programa, argumentos, ambiente ou caminho.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jsonrpc",
    "id",
    "result"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "$ref": "urn:ads:common:ulid:1"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harnesses",
        "workdir_aliases"
      ],
      "properties": {
        "harnesses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:ads:common:id:1"
          }
        },
        "workdir_aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:ads:common:id:1"
          },
          "description": "Apelidos disponíveis para abrir uma sessão."
        },
        "missing_workdir_aliases": {
          "description": "Apelidos cujos caminhos estavam inacessíveis ou não resolviam para uma pasta na partida.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:ads:common:id:1"
          }
        }
      }
    }
  },
  "examples": [
    {
      "jsonrpc": "2.0",
      "id": "01ARZ3NDEKTSV4RRFFQ69G5FAD",
      "result": {
        "harnesses": [
          "claude",
          "codex"
        ],
        "workdir_aliases": [
          "default"
        ]
      }
    }
  ]
}
