{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:contract:pty-host.notification:1",
  "title": "Aviso do host de PTY",
  "description": "Notificação JSON-RPC 2.0 (sem id, sem resposta) do host de PTY ao núcleo: o processo de uma sessão terminou, ou uma assinatura foi encerrada. last_seq é o último pedaço numerado (0 se não houve saída); o núcleo reassina a partir de last_seq + 1 sem perder nada.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "session.exited"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "exit_code",
            "last_seq"
          ],
          "properties": {
            "session_id": {
              "$ref": "urn:ads:common:id:1"
            },
            "exit_code": {
              "type": [
                "integer",
                "null"
              ]
            },
            "last_seq": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "subscription.closed"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "reason",
            "last_seq"
          ],
          "properties": {
            "session_id": {
              "$ref": "urn:ads:common:id:1"
            },
            "reason": {
              "enum": [
                "slow_subscriber",
                "session_closed"
              ]
            },
            "last_seq": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "jsonrpc": "2.0",
      "method": "session.exited",
      "params": {
        "session_id": "sess-01",
        "exit_code": 0,
        "last_seq": 50
      }
    }
  ]
}
