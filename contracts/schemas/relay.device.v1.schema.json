{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:relay:device:1",
  "title": "Aparelho inscrito no relé",
  "description": "O que o relé guarda de um aparelho: o identificador opaco e a chave pública (32 bytes em base64). Chave privada, passkey e credencial de IA nunca chegam ao relé; a passkey é conferida pelo núcleo, dentro do canal cifrado.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "device_id",
    "public_key",
    "registered_at"
  ],
  "properties": {
    "device_id": {
      "$ref": "urn:ads:common:id:1"
    },
    "public_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    },
    "registered_at": {
      "$ref": "urn:ads:common:timestamp:1"
    }
  },
  "examples": [
    {
      "device_id": "device-phone",
      "public_key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
      "registered_at": "2030-01-02T03:04:05Z"
    }
  ]
}
