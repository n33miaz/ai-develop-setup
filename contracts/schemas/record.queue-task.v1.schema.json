{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:record:queue-task:1",
  "title": "Tarefa da fila",
  "description": "Retrato versionado de uma tarefa. A pasta é referida por apelido; o teto de tentativas inclui a primeira execução.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "queue_id",
    "origin",
    "title",
    "workspace_alias",
    "tool",
    "state",
    "attempts",
    "attempt_limit",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "$ref": "urn:ads:common:id:1"
    },
    "queue_id": {
      "$ref": "urn:ads:common:id:1"
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "request_id"
          ],
          "properties": {
            "kind": {
              "const": "manual"
            },
            "request_id": {
              "$ref": "urn:ads:common:id:1"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "const": "issue"
            },
            "ref": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "rule_id",
            "target_id"
          ],
          "properties": {
            "kind": {
              "const": "bug_rule"
            },
            "rule_id": {
              "$ref": "urn:ads:common:id:1"
            },
            "target_id": {
              "$ref": "urn:ads:common:id:1"
            }
          }
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ufeff]*$"
    },
    "workspace_alias": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9._-]{0,62}[a-z0-9_-])?$",
      "not": {
        "pattern": "(^((con|prn|aux|nul|com[0-9]|lpt[0-9])(\\.|$)))|\\.\\."
      }
    },
    "tool": {
      "$ref": "urn:ads:common:id:1"
    },
    "state": {
      "$ref": "urn:ads:common:queue-task-state:1"
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "attempt_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "created_at": {
      "$ref": "urn:ads:common:timestamp:1"
    },
    "updated_at": {
      "$ref": "urn:ads:common:timestamp:1"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(feature|fix)/[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$",
      "not": {
        "pattern": "\\.\\.|\\.lock(/|$)|\\.$"
      }
    },
    "pull_request": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "examples": [
    {
      "version": 1,
      "id": "task-01",
      "queue_id": "queue-01",
      "origin": {
        "kind": "manual",
        "request_id": "request-01"
      },
      "title": "Conferir documentação",
      "workspace_alias": "docs",
      "tool": "tool-a",
      "state": "queued",
      "attempts": 0,
      "attempt_limit": 2,
      "created_at": "2030-01-02T03:04:05Z",
      "updated_at": "2030-01-02T03:04:05Z"
    }
  ]
}
