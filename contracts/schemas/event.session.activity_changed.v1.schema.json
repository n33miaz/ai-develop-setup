{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:event:session.activity_changed:1",
  "title": "Atividade da sessão mudou",
  "description": "A sessão passou de ativa para ociosa ou de ociosa para ativa. Ativa: o terminal produziu saída ou recebeu entrada há pouco; ociosa: está parada, à espera. Sessão recém-criada conta como ativa até o primeiro evento destes; o tempo de silêncio que a torna ociosa é parâmetro de quem emite.",
  "allOf": [
    {
      "$ref": "urn:ads:event:envelope:1"
    },
    {
      "type": "object",
      "required": [
        "type",
        "stream",
        "data"
      ],
      "properties": {
        "type": {
          "const": "urn:ads:event:session.activity_changed:1"
        },
        "stream": {
          "type": "string",
          "pattern": "^session/"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "activity"
          ],
          "properties": {
            "session_id": {
              "$ref": "urn:ads:common:id:1"
            },
            "activity": {
              "enum": [
                "active",
                "idle"
              ]
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "id": "01ARZ3NDEKTSV4RRFFQ69G5FAB",
      "type": "urn:ads:event:session.activity_changed:1",
      "ts": "2030-01-02T03:04:05Z",
      "stream": "session/sess-01",
      "seq": 1,
      "actor": {
        "kind": "daemon",
        "id": "core-01"
      },
      "cause": null,
      "data_class": "internal",
      "data": {
        "session_id": "sess-01",
        "activity": "idle"
      }
    }
  ]
}
