{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:event:queue.created:1",
  "title": "Fila criada",
  "description": "Registra a fila inicial parada e a identidade cadastrada do dono.",
  "allOf": [
    {
      "$ref": "urn:ads:event:envelope:1"
    },
    {
      "type": "object",
      "required": [
        "type",
        "stream",
        "data",
        "actor"
      ],
      "properties": {
        "type": {
          "const": "urn:ads:event:queue.created:1"
        },
        "stream": {
          "type": "string",
          "pattern": "^queue/"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "queue_id",
            "owner_id",
            "via",
            "state"
          ],
          "properties": {
            "queue_id": {
              "$ref": "urn:ads:common:id:1"
            },
            "owner_id": {
              "$ref": "urn:ads:common:id:1"
            },
            "via": {
              "enum": [
                "local_ui",
                "tray",
                "remote_device"
              ]
            },
            "state": {
              "const": "stopped"
            }
          }
        },
        "actor": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "kind": {
              "const": "device"
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "id": "01ARZ3NDEKTSV4RRFFQ69G5FAB",
      "type": "urn:ads:event:queue.created:1",
      "ts": "2030-01-02T03:04:05Z",
      "stream": "queue/queue-01",
      "seq": 1,
      "actor": {
        "kind": "device",
        "id": "device-01"
      },
      "cause": null,
      "data_class": "internal",
      "data": {
        "queue_id": "queue-01",
        "owner_id": "owner-01",
        "via": "local_ui",
        "state": "stopped"
      }
    }
  ]
}
