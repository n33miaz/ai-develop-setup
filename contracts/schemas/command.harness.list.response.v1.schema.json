{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:command:harness.list.response:1",
  "title": "Resposta de harness.list",
  "description": "Resposta JSON-RPC 2.0 aceita de harness.list: os identificadores das ferramentas ligadas na configuração do usuário e os apelidos de pasta de trabalho, só nomes. Nunca leva programa, argumentos, ambiente nem caminho. A recusa volta como command.response:2 com error.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jsonrpc",
    "id",
    "result"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "$ref": "urn:ads:common:ulid:1"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harnesses",
        "workdir_aliases"
      ],
      "properties": {
        "harnesses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:ads:common:id:1"
          }
        },
        "workdir_aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:ads:common:id:1"
          }
        }
      }
    }
  },
  "examples": [
    {
      "jsonrpc": "2.0",
      "id": "01ARZ3NDEKTSV4RRFFQ69G5FAD",
      "result": {
        "harnesses": [
          "claude",
          "codex"
        ],
        "workdir_aliases": [
          "default"
        ]
      }
    }
  ]
}
