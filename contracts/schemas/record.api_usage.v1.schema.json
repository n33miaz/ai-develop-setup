{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:record:api_usage:1",
  "title": "Uso de uma chamada de API",
  "description": "O que o adaptador de API informa de uma chamada direta a um provedor: alias do provedor, modelo, tokens, custo estimado em micro-dólares e a base do custo. Nunca leva texto do pedido nem da resposta, nem chave. O chamador o amplia para o registro usage_event.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "ts",
    "provider_alias",
    "model",
    "tokens_in",
    "tokens_out",
    "cost_estimate_micro_usd",
    "cost_basis",
    "price_version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "ts": {
      "$ref": "urn:ads:common:timestamp:1"
    },
    "provider_alias": {
      "$ref": "urn:ads:common:id:1"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tokens_in": {
      "type": "integer",
      "minimum": 0
    },
    "tokens_out": {
      "type": "integer",
      "minimum": 0
    },
    "cost_estimate_micro_usd": {
      "type": "integer",
      "minimum": 0
    },
    "cost_basis": {
      "enum": [
        "reported",
        "reserved"
      ]
    },
    "price_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    }
  },
  "examples": [
    {
      "version": 1,
      "ts": "2030-01-02T03:04:05Z",
      "provider_alias": "provider-a",
      "model": "model-x",
      "tokens_in": 1200,
      "tokens_out": 340,
      "cost_estimate_micro_usd": 4500,
      "cost_basis": "reported",
      "price_version": "prices-2030-01-01"
    }
  ]
}
