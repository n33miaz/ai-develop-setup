{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:record:parameter:1",
  "title": "Parâmetro",
  "description": "Um parâmetro do produto como o núcleo o apresenta: a chave, o tipo, o padrão recomendado, o valor em vigor e a explicação. Todo comportamento com mais de uma escolha razoável é um registro destes. Parâmetro nunca guarda segredo: segredo fica no cofre.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "key",
    "type",
    "default",
    "value",
    "description"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "maxLength": 96
    },
    "type": {
      "enum": [
        "string",
        "integer",
        "number",
        "boolean",
        "string_list"
      ]
    },
    "default": {
      "$ref": "#/$defs/value"
    },
    "value": {
      "$ref": "#/$defs/value"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "choices": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "string"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "default": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "choices"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "integer"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "default": {
            "type": "integer"
          },
          "value": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "number"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "default": {
            "type": "number"
          },
          "value": {
            "type": "number"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "boolean"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "default": {
            "type": "boolean"
          },
          "value": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "string_list"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "default": {
            "type": "array"
          },
          "value": {
            "type": "array"
          }
        }
      }
    }
  ],
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        }
      ]
    }
  },
  "examples": [
    {
      "version": 1,
      "key": "workflow.issue_per_task",
      "type": "boolean",
      "default": true,
      "value": true,
      "description": "Uma issue por entrega; false desliga o aviso do template de PR."
    }
  ]
}
