{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:event:session.permission_asked:1",
  "title": "Pergunta de permissão",
  "description": "O CLI de IA pediu permissão para algo (comando, escrita, rede). O resumo pode conter texto do usuário, então a classe é private ou secret.",
  "allOf": [
    {
      "$ref": "urn:ads:event:envelope:1"
    },
    {
      "type": "object",
      "required": [
        "type",
        "stream",
        "data"
      ],
      "properties": {
        "type": {
          "const": "urn:ads:event:session.permission_asked:1"
        },
        "stream": {
          "type": "string",
          "pattern": "^session/"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "request_id",
            "kind",
            "summary",
            "expires_at"
          ],
          "properties": {
            "session_id": {
              "$ref": "urn:ads:common:id:1"
            },
            "request_id": {
              "$ref": "urn:ads:common:id:1"
            },
            "kind": {
              "enum": [
                "tool_use",
                "file_write",
                "command",
                "network",
                "other"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "expires_at": {
              "anyOf": [
                {
                  "$ref": "urn:ads:common:timestamp:1"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "data_class": {
          "enum": [
            "private",
            "secret"
          ]
        }
      }
    }
  ],
  "examples": [
    {
      "id": "01ARZ3NDEKTSV4RRFFQ69G5FAB",
      "type": "urn:ads:event:session.permission_asked:1",
      "ts": "2030-01-02T03:04:05Z",
      "stream": "session/sess-01",
      "seq": 1,
      "actor": {
        "kind": "daemon",
        "id": "core-01"
      },
      "cause": null,
      "data_class": "private",
      "data": {
        "session_id": "sess-01",
        "request_id": "req-01",
        "kind": "command",
        "summary": "Executar o teste da suíte",
        "expires_at": "2030-01-02T03:09:05Z"
      }
    }
  ]
}
