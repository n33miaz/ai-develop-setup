              "$ref": "urn:ads:common:id:1"
            },
            "program": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "cwd": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                {
                  "type": "null"
                }
              ]
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "cols": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
