{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:contract:pty-host.request:1",
  "title": "Pedido ao host de PTY",
  "description": "Pedido JSON-RPC 2.0 do núcleo ao host de PTY no contrato pty-host/1, com envelope próprio: id inteiro por conexão, sem chave de idempotência nem assinatura, porque o canal é local e do próprio usuário. Os bytes de saída do terminal não vêm em resposta: viajam no quadro binário.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "method": {
          "const": "host.hello"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract"
          ],
          "properties": {
            "contract": {
              "const": "pty-host/1"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "method": {
          "const": "session.open"
        },
        "params": {
          "type": "object",
