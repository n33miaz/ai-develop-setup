          "const": "2.0"
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "method": {
          "const": "session.write"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "data"
          ],
          "properties": {
            "session_id": {
              "$ref": "urn:ads:common:id:1"
            },
            "data": {
              "$ref": "urn:ads:common:base64:1"
            }
          }
        }
      }
    },
    {
