{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:command:request:1",
  "title": "Envelope de comando",
  "description": "Comando JSON-RPC 2.0 enviado ao núcleo. Comando é pedido, não fato; a chave de idempotência evita executar duas vezes, e a origem remota exige assinatura do aparelho, nonce, contador e validade.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jsonrpc",
    "id",
    "method",
    "params"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "$ref": "urn:ads:common:ulid:1"
    },
    "method": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "maxLength": 64
    },
    "params": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "_meta"
      ],
      "properties": {
        "_meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idempotency_key",
            "origin"
          ],
          "properties": {
            "idempotency_key": {
              "$ref": "urn:ads:common:ulid:1"
            },
            "origin": {
              "enum": [
                "local",
                "remote"
              ]
            },
            "remote": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "device_id",
                "signature",
                "nonce",
                "counter",
                "expires_at"
              ],
              "properties": {
                "device_id": {
                  "$ref": "urn:ads:common:id:1"
                },
                "signature": {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                  "minLength": 88,
                  "maxLength": 88
                },
                "nonce": {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                  "minLength": 22
                },
                "counter": {
                  "type": "integer",
                  "minimum": 1
                },
                "expires_at": {
                  "$ref": "urn:ads:common:timestamp:1"
                }
              }
            }
          },
          "if": {
            "properties": {
              "origin": {
                "const": "remote"
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "required": [
              "remote"
            ]
          },
          "else": {
            "not": {
              "required": [
                "remote"
              ]
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "jsonrpc": "2.0",
      "id": "01ARZ3NDEKTSV4RRFFQ69G5FAD",
      "method": "session.write",
      "params": {
        "session_id": "sess-01",
        "_meta": {
          "idempotency_key": "01ARZ3NDEKTSV4RRFFQ69G5FAE",
          "origin": "local"
        }
      }
    }
  ]
}
