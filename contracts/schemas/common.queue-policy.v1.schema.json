{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads:common:queue-policy:1",
  "title": "Limites da fila",
  "description": "Limites de admissão e prazo de confirmação da sessão pelo host.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt_limit",
    "admission_limit",
    "window_seconds",
    "window_admissions",
    "manual_window_admissions",
    "bug_rule_window_admissions",
    "clock_skew_seconds",
    "clock_rewind_seconds",
    "host_confirm_seconds"
  ],
  "properties": {
    "attempt_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "admission_limit": {
      "type": "integer",
      "minimum": 1
    },
    "window_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "window_admissions": {
      "type": "integer",
      "minimum": 1
    },
    "manual_window_admissions": {
      "type": "integer",
      "minimum": 1
    },
    "bug_rule_window_admissions": {
      "type": "integer",
      "minimum": 1
    },
    "clock_skew_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "clock_rewind_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "host_confirm_seconds": {
      "type": "integer",
      "minimum": 1
    }
  },
  "examples": [
    {
      "attempt_limit": 2,
      "admission_limit": 1000,
      "window_seconds": 3600,
      "window_admissions": 10,
      "manual_window_admissions": 10,
      "bug_rule_window_admissions": 3,
      "clock_skew_seconds": 5,
      "clock_rewind_seconds": 300,
      "host_confirm_seconds": 60
    }
  ]
}
